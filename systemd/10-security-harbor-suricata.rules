// Tillåter ENDAST security-harbor-tjänstekontot att starta/stoppa/starta om
// EXAKT suricata.service (inget annat systemd-anrop, ingen annan
// användare) — se pkg/adapter/suricata/adapter.go. Precis som DNS/
// WireGuard/OpenVPN körs anropet direkt av agentprocessen (D-Bus-anropet
// exekveras av systemd/PID1 med systemds egna rättigheter, ingen egen
// privilegiehöjning krävs i agentprocessen) — men utan denna polkit-regel
// avvisas anropet ändå, eftersom security-harbor-tjänstekontot saknar
// admin-grupp.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        (action.lookup("unit") == "suricata.service" ||
         // Regeluppdateringen (suricata-update + live-reload) körs som en
         // privilegierad oneshot-enhet — agenten är inte root och
         // suricata-update skriver till /var/lib/suricata. Triggas från
         // IDS-regelvyn i GUI:t när kategorier eller signaturer ändras.
         action.lookup("unit") == "security-harbor-suricata-update.service") &&
        subject.user == "security-harbor") {
        return polkit.Result.YES;
    }
});
