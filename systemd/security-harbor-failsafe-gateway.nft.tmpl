# Security Harbor Failsafe nftables ruleset — GATEWAY-läge.
# Denna laddas av security-harbor-failsafe.service innan agenten startar.
# Syfte: Garantera fail-closed på WAN samtidigt som SSH (22) och
# Management API (8443) tillåts på LAN.
#
# Genereras av install.sh vid installationstillfället (INTE en statisk,
# checkad-in fil — se install.sh) med det faktiska WAN-gränssnittets
# devicenamn substituerat i {{WAN_DEVICE}} nedan. En statisk fil hade bara
# råkat stämma på en enda referensmaskin och varit fel/farlig (öppnar
# SSH/API mot ALLT som inte har det förväntade namnet) på vilken riktig
# installation som helst med andra gränssnittsnamn.

flush ruleset

table inet security_harbor_failsafe {
    chain input {
        type filter hook input priority filter; policy drop;

        # Tillåt alltid loopback
        iifname "lo" accept

        # Tillåt etablerade och relaterade anslutningar (Stateful)
        ct state established,related accept

        # Tillåt SSH (22) och Management API (8443) på LAN / icke-WAN interfaces
        iifname != "{{WAN_DEVICE}}" tcp dport { 22, 8443 } accept

        # Drop allt annat tyst (WAN är 100% stängd/stealth)
        drop
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
    }

    chain output {
        type filter hook output priority filter; policy accept;
    }
}
