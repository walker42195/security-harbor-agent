// Tillåter ENDAST security-harbor-tjänstekontot att starta/stoppa/starta om
// EXAKT kea-dhcp4-server.service (inget annat systemd-anrop, ingen annan
// användare) — se pkg/adapter/dhcp/adapter.go (DHCP-server). Precis som
// suricata/unbound körs anropet direkt av agentprocessen (D-Bus-anropet
// exekveras av systemd/PID1 med systemds egna rättigheter, ingen egen
// privilegiehöjning krävs i agentprocessen) — men utan denna polkit-regel
// avvisas anropet ändå eftersom security-harbor-tjänstekontot saknar
// admin-grupp ("Access denied ... requires interactive authentication").
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "kea-dhcp4-server.service" &&
        subject.user == "security-harbor") {
        return polkit.Result.YES;
    }
});
