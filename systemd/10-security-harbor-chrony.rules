// Tillåter ENDAST security-harbor-tjänstekontot att starta om EXAKT
// chrony.service (inget annat systemd-anrop, ingen annan användare) — se
// pkg/adapter/ntp. Brandväggen agerar NTP-server åt de interna näten, och
// konfigurationen skrivs i /etc/chrony/conf.d.
//
// Samma mönster som unbound/kea/suricata: anropet exekveras av systemd/PID1,
// men utan den här regeln avvisas det eftersom tjänstekontot saknar
// admin-grupp.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "chrony.service" &&
        subject.user == "security-harbor") {
        return polkit.Result.YES;
    }
});
