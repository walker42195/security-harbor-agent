// Tillåter ENDAST security-harbor-tjänstekontot att starta/stoppa/starta om
// EXAKT haproxy.service (inget annat systemd-anrop, ingen annan användare) —
// se pkg/adapter/haproxy/adapter.go (SNI-routning). Samma mönster som
// suricata/openvpn: anropet exekveras av systemd/PID1, men utan denna
// polkit-regel avvisas det eftersom security-harbor-kontot saknar admin-grupp.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "haproxy.service" &&
        subject.user == "security-harbor") {
        return polkit.Result.YES;
    }
});
