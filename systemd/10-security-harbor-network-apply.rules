// Tillåter ENDAST security-harbor-tjänstekontot att starta EXAKT
// security-harbor-network-apply.service (inget annat systemd-anrop, ingen
// annan användare) — se pkg/adapter/network/helper.go och
// cmd/security-harbor-network-runner. Utan denna regel avvisar polkit
// `systemctl start` från ett icke-interaktivt tjänstekonto som saknar
// admin-grupp.
//
// Själva skrivningen till /etc/netplan (respektive /etc/systemd/network eller
// NetworkManagers profiler) och anropen till netplan/networkctl/nmcli sker
// uteslutande i den root-oneshoten, aldrig i den härdade daemon-processen.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "security-harbor-network-apply.service" &&
        subject.user == "security-harbor") {
        return polkit.Result.YES;
    }
});
