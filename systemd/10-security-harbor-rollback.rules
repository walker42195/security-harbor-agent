// Tillåter ENDAST security-harbor-tjänstekontot att starta EXAKT
// instanser av security-harbor-rollback@.service (inget annat
// systemd-anrop, ingen annan användare) — se
// pkg/api/server.go:handleRollbackVersion. Utan denna regel avvisar
// polkit `systemctl start` från ett icke-interaktivt tjänstekonto som
// saknar admin-grupp. Installationen (byte av binärer i /usr/local/bin,
// omstart av agenten) sker uteslutande i rollback-runner.sh som root,
// aldrig i den härdade daemon-processen.
//
// Mallenhet - instansnamnet varierar (versionssträngen), så matchningen
// sker på prefix, inte exakt sträng (jfr 10-security-harbor-update.rules
// som matchar en icke-mallenhet exakt).
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit").indexOf("security-harbor-rollback@") == 0 &&
        action.lookup("unit").endsWith(".service") &&
        subject.user == "security-harbor") {
        return polkit.Result.YES;
    }
});
