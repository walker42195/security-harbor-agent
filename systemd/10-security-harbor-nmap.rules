// Tillåter ENDAST security-harbor-tjänstekontot att starta EXAKT
// security-harbor-nmap.service (inget annat systemd-anrop, ingen annan
// användare) — se pkg/api/server.go:runNmapViaHelperService och
// cmd/security-harbor-nmap-runner. Utan denna regel avvisar polkit
// `systemctl start` från ett icke-interaktivt tjänstekonto som saknar
// admin-grupp.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "security-harbor-nmap.service" &&
        subject.user == "security-harbor") {
        return polkit.Result.YES;
    }
});
