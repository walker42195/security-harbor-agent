// Tillåter ENDAST security-harbor-tjänstekontot att starta/stoppa/starta om
// EXAKT unbound.service (inget annat systemd-anrop, ingen annan användare) —
// se pkg/adapter/dns/adapter.go (DNS-resolver). Precis som suricata/haproxy
// körs anropet direkt av agentprocessen (D-Bus-anropet exekveras av
// systemd/PID1 med systemds egna rättigheter, ingen egen privilegiehöjning
// krävs i agentprocessen) — men utan denna polkit-regel avvisas anropet ändå
// eftersom security-harbor-tjänstekontot saknar admin-grupp ("Access denied
// as the requested operation requires interactive authentication").
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "unbound.service" &&
        subject.user == "security-harbor") {
        return polkit.Result.YES;
    }
});
