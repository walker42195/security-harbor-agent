[Unit]
Description=Security Harbor Firewall Management Agent
After=network.target security-harbor-failsafe.service
Requires=security-harbor-failsafe.service

[Service]
Type=simple
User=security-harbor
Group=security-harbor
# _kea: krävs för att läsa Kea:s lease-databas (/var/lib/kea/kea-leases4.csv,
# rw-r----- ägd av _kea:_kea) — används för DNS.DHCPHostnameRegistration.
# Utan den här gruppen misslyckas läsningen tyst med "permission denied" så
# fort funktionen slås på, även om resten av agenten fungerar normalt.
# systemd-journal: krävs för att läsa KÄRNLOGGEN (`journalctl -k`) där
# nftables loggar accepterad/nekad trafik (SH-ACCEPT-/SH-DENY-prefixen) — det
# är källan till trafikloggen i GUI:t (se parseFirewallLog i pkg/api). Utan
# den här gruppen får det oprivilegierade tjänstekontot tomt svar och GUI-
# loggen visar ingen trafik alls, trots att kärnan loggar den (upptäckt på ny
# server 2026-08-23: paketfångst visade trafik men loggen var tom).
SupplementaryGroups=_kea systemd-journal
ExecStart=/usr/local/bin/security-harbor-agent --data-dir /var/lib/security-harbor
Restart=always
RestartSec=5s

# Capability-baserad behörighet istället för ren root (Steg 0.3)
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE

# Systemd Sandboxning & Härdning
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RuntimeDirectory=security-harbor
ReadWritePaths=/var/lib/security-harbor /etc/security-harbor /run/security-harbor /etc/kea /etc/wireguard /etc/openvpn /etc/unbound /etc/rsyslog.d /etc/suricata /var/log/suricata /etc/haproxy
ProtectKernelTunables=false
ProtectKernelModules=false
ProtectControlGroups=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictNamespaces=true

[Install]
WantedBy=multi-user.target
