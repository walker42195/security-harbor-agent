[Unit]
Description=Security Harbor Firewall Management Agent
After=network.target security-harbor-failsafe.service
Requires=security-harbor-failsafe.service

[Service]
Type=simple
User=security-harbor
Group=security-harbor
# _kea: krävs för att läsa Kea:s lease-databas (/var/lib/kea/kea-leases4.csv,
# rw-r----- ägd av _kea:_kea) — används för DNS.DHCPHostnameRegistration.
# Utan den här gruppen misslyckas läsningen tyst med "permission denied" så
# fort funktionen slås på, även om resten av agenten fungerar normalt.
SupplementaryGroups=_kea
ExecStart=/usr/local/bin/security-harbor-agent --data-dir /var/lib/security-harbor
Restart=always
RestartSec=5s

# Capability-baserad behörighet istället för ren root (Steg 0.3)
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE

# Systemd Sandboxning & Härdning
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RuntimeDirectory=security-harbor
ReadWritePaths=/var/lib/security-harbor /etc/security-harbor /run/security-harbor /etc/kea /etc/wireguard /etc/openvpn /etc/unbound
ProtectKernelTunables=false
ProtectKernelModules=false
ProtectControlGroups=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictNamespaces=true

[Install]
WantedBy=multi-user.target
