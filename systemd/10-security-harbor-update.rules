// Tillåter ENDAST security-harbor-tjänstekontot att starta EXAKT
// security-harbor-update.service (inget annat systemd-anrop, ingen annan
// användare) — se pkg/api/server.go:handleUpdateApply. Utan denna regel
// avvisar polkit `systemctl start` från ett icke-interaktivt tjänstekonto
// som saknar admin-grupp. Installationen (byte av binärer i /usr/local/bin,
// omstart av agenten) sker uteslutande i den root-oneshoten, aldrig i den
// härdade daemon-processen.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "security-harbor-update.service" &&
        subject.user == "security-harbor") {
        return polkit.Result.YES;
    }
});
