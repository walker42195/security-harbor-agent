# Security Harbor Failsafe nftables ruleset
# Denna laddas av security-harbor-failsafe.service innan agenten startar.
# Syfte: Garantera fail-closed vid krasch/omstart samtidigt som lokal SSH-management tillåts på LAN.

flush ruleset

table inet security_harbor_failsafe {
    chain input {
        type filter hook input priority filter; policy drop;

        # Tillåt alltid loopback
        iifname "lo" accept

        # Tillåt etablerade och relaterade anslutningar (Stateful)
        ct state established,related accept

        # Tillåt SSH (port 22) endast på LAN / icke-WAN interfaces
        iifname != "ens18" tcp dport 22 accept

        # Drop allt annat tyst (WAN är 100% stängd/stealth)
        drop
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
    }

    chain output {
        type filter hook output priority filter; policy accept;
    }
}
